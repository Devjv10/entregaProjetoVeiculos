generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

enum Category {
  ECONOMY
  SEDAN
  SUV
  HATCH
  PICKUP
  LUXURY
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum RentalStatus {
  ACTIVE
  COMPLETED
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255)
  role      Role     @default(CLIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rentals   Rental[]
}

model Vehicle {
  id        String        @id @default(uuid()) @db.Char(36)
  brand     String        @db.VarChar(60)
  model     String        @db.VarChar(80)
  year      Int
  plate     String        @unique @db.VarChar(7)
  color     String        @db.VarChar(40)
  category  Category
  dailyRate Decimal       @db.Decimal(10, 2)
  status    VehicleStatus @default(AVAILABLE)
  imageUrl  String?       @db.VarChar(2048)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  rentals   Rental[]

  @@index([status, category])
}

model Rental {
  id                  String       @id @default(uuid()) @db.Char(36)
  userId              String       @db.Char(36)
  vehicleId           String       @db.Char(36)
  startDate           DateTime
  expectedReturnDate  DateTime
  actualReturnDate    DateTime?
  contractedDailyRate Decimal      @db.Decimal(10, 2)
  estimatedTotal      Decimal      @db.Decimal(12, 2)
  finalTotal          Decimal?     @db.Decimal(12, 2)
  status              RentalStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([vehicleId, status])
  @@index([status, createdAt])
}
